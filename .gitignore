# --- 构建产物（wheel / sdist 应由 CI 或 Releases 生成，不入源码仓库）---
build/
dist/
dist_new/
*.egg-info/
*.whl
*.tar.gz
PKG-INFO

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*.pyo

# --- 运行时产物 ---
# pyvis 生成网络图时释放的静态资源（非本项目源码）
lib/
# 示例运行结果（可由 examples/data 复现，体积大）
examples/run_output/

# --- 虚拟环境 ---
venv/
.venv/
env/

# --- IDE / 系统 ---
.idea/
.vscode/
.DS_Store
Thumbs.db
